{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChickenGPT facts file",
  "type": "object",
  "required": ["facts"],
  "properties": {
    "about": { "type": "string" },
    "facts": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fact", "sources", "submitted_by", "submitted_on"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 3, "maxLength": 60 },
          "fact": { "type": "string", "minLength": 30, "maxLength": 280 },
          "quip": { "type": "string", "maxLength": 140 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "title"],
              "properties": {
                "url": { "type": "string", "pattern": "^https://", "maxLength": 500 },
                "title": { "type": "string", "minLength": 3, "maxLength": 150 }
              }
            }
          },
          "submitted_by": { "type": "string", "minLength": 2, "maxLength": 80 },
          "submitted_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "notes": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
